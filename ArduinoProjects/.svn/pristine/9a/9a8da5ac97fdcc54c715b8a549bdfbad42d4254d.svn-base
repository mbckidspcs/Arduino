#include <WiFi.h>
#include <PubSubClient.h>

// ================= WIFI & MQTT =================
const char* ssid = "Dialog 4G 713";
const char* password = "123456789";

const char* mqttServer = "broker.hivemq.com";
const int   mqttPort   = 1883;
const char* topic      = "kd/rc/pwm6";

// ================= CONSTANTS =================
#define CHANNELS       6
#define FAILSAFE_US    1500       // Neutral / failsafe
#define RC_TIMEOUT_MS  120        // RC signal loss time

// ================= PINS =================
const int pwmPins[CHANNELS] = {13, 12, 14, 27, 26, 25};

// ================= GLOBALS =================
WiFiClient espClient;
PubSubClient client(espClient);

volatile uint32_t riseTimes[CHANNELS] = {0};
volatile uint16_t pwmValues[CHANNELS] = {FAILSAFE_US, FAILSAFE_US, FAILSAFE_US, FAILSAFE_US, FAILSAFE_US, FAILSAFE_US};
volatile bool updated[CHANNELS] = {false};

unsigned long lastRC = 0;
unsigned long lastPrint = 0;
unsigned long lastMQTT = 0;

// ================= INTERRUPT HANDLER =================
void IRAM_ATTR pwmISR0() { 
  if (digitalRead(pwmPins[0])) riseTimes[0] = micros();
  else { pwmValues[0] = micros() - riseTimes[0]; updated[0]=true; lastRC=millis(); }
}

void IRAM_ATTR pwmISR1() { 
  if (digitalRead(pwmPins[1])) riseTimes[1] = micros();
  else { pwmValues[1] = micros() - riseTimes[1]; updated[1]=true; lastRC=millis(); }
}

void IRAM_ATTR pwmISR2() { 
  if (digitalRead(pwmPins[2])) riseTimes[2] = micros();
  else { pwmValues[2] = micros() - riseTimes[2]; updated[2]=true; lastRC=millis(); }
}

void IRAM_ATTR pwmISR3() { 
  if (digitalRead(pwmPins[3])) riseTimes[3] = micros();
  else { pwmValues[3] = micros() - riseTimes[3]; updated[3]=true; lastRC=millis(); }
}

void IRAM_ATTR pwmISR4() { 
  if (digitalRead(pwmPins[4])) riseTimes[4] = micros();
  else { pwmValues[4] = micros() - riseTimes[4]; updated[4]=true; lastRC=millis(); }
}

void IRAM_ATTR pwmISR5() { 
  if (digitalRead(pwmPins[5])) riseTimes[5] = micros();
  else { pwmValues[5] = micros() - riseTimes[5]; updated[5]=true; lastRC=millis(); }
}

// ================= WIFI / MQTT =================
void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;
  WiFi.begin(ssid, password);
  Serial.print("Wi-Fi connecting");
  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
  }
  Serial.println("\nWi-Fi connected");
}

void connectMQTT() {
  if (client.connected()) return;
  if (millis() - lastMQTT < 2000) return; // retry every 2s
  lastMQTT = millis();
  String cid = "ESP32_PWM_TX_" + String((uint32_t)ESP.getEfuseMac(), HEX);
  if (client.connect(cid.c_str())) Serial.println("MQTT connected");
  else Serial.print("MQTT failed: "), Serial.println(client.state());
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  for (int i=0; i<CHANNELS; i++) {
    pinMode(pwmPins[i], INPUT);
  }

  // attach interrupts
  attachInterrupt(digitalPinToInterrupt(pwmPins[0]), pwmISR0, CHANGE);
  attachInterrupt(digitalPinToInterrupt(pwmPins[1]), pwmISR1, CHANGE);
  attachInterrupt(digitalPinToInterrupt(pwmPins[2]), pwmISR2, CHANGE);
  attachInterrupt(digitalPinToInterrupt(pwmPins[3]), pwmISR3, CHANGE);
  attachInterrupt(digitalPinToInterrupt(pwmPins[4]), pwmISR4, CHANGE);
  attachInterrupt(digitalPinToInterrupt(pwmPins[5]), pwmISR5, CHANGE);

  connectWiFi();
  client.setServer(mqttServer, mqttPort);
}

// ================= LOOP =================
void loop() {
  connectWiFi();
  connectMQTT();
  client.loop();

  // --- FAILSAFE ---
  if (millis() - lastRC > RC_TIMEOUT_MS) {
    for (int i=0; i<CHANNELS; i++) pwmValues[i] = FAILSAFE_US;
  }

  // --- MQTT PUBLISH ---
  static unsigned long lastPublish = 0;
  if (millis() - lastPublish > 20) { // 50 Hz
    lastPublish = millis();
    if (client.connected()) client.publish(topic, (uint8_t*)pwmValues, sizeof(pwmValues));
  }

  // --- DEBUG PRINT ---
  if (millis() - lastPrint > 100) { // 10 Hz
    lastPrint = millis();
    Serial.print("PWM: ");
    for (int i=0; i<CHANNELS; i++) {
      Serial.print(pwmValues[i]);
      Serial.print(" ");
    }
    Serial.print(lastRC>0 ? "| RX OK" : "| FAILSAFE");
    Serial.println();
  }
}
