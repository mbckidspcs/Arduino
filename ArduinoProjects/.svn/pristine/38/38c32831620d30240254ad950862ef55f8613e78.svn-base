#include <WiFi.h>
#include <PubSubClient.h>
#include <ESP32Servo.h>

// ================= WIFI & MQTT =================
const char* ssid = "Dialog 4G 713";
const char* password = "123456789";
const char* mqttServer = "broker.hivemq.com";
const int   mqttPort = 1883;
const char* topic = "kd/rc/pwm6";

// ================= CONSTANTS =================
#define CHANNELS 6
#define FAILSAFE_US 1500    // default PWM if no signal
#define RC_TIMEOUT_MS 120

// ================= PINS =================
const int pwmPins[CHANNELS] = {13, 12, 14, 27, 26, 25};

// ================= GLOBALS =================
WiFiClient espClient;
PubSubClient client(espClient);
uint16_t pwmValues[CHANNELS] = {FAILSAFE_US, FAILSAFE_US, FAILSAFE_US, FAILSAFE_US, FAILSAFE_US, FAILSAFE_US};
unsigned long lastMsg = 0;

// ================= SERVOS =================
Servo servos[CHANNELS];

// ================= MQTT CALLBACK =================
void callback(char* topic, byte* payload, unsigned int length) {
  if(length != CHANNELS * 2) return; // sanity check for 6x 16-bit values
  memcpy(pwmValues, payload, length); 
  lastMsg = millis();
}

// ================= WIFI / MQTT =================
void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;
  WiFi.begin(ssid, password);
  Serial.print("Wi-Fi connecting");
  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
  }
  Serial.println("\nWi-Fi connected");
}

void connectMQTT() {
  if (client.connected()) return;
  String cid = "ESP32_PWM_RX_" + String((uint32_t)ESP.getEfuseMac(), HEX);
  if (client.connect(cid.c_str())) {
    Serial.println("MQTT connected");
    client.subscribe(topic);
  } else {
    Serial.print("MQTT failed: "); Serial.println(client.state());
  }
}

// ================= MAP PWM TO SERVO =================
int pwmToAngle(int pwm){
  if(pwm > 1500) 
    return 96;

  if(pwm > 1450) 
    return 90;
  
  return 85;
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  // Attach servos
  for(int i=0;i<CHANNELS;i++){
    servos[i].attach(pwmPins[i]);
  }

  connectWiFi();
  client.setServer(mqttServer, mqttPort);
  client.setCallback(callback);
}

// ================= LOOP =================
void loop() {
  connectWiFi();
  connectMQTT();
  client.loop();

  // Update servos
  for(int i=0;i<CHANNELS;i++){
    int pwm = (millis() - lastMsg > RC_TIMEOUT_MS) ? FAILSAFE_US : pwmValues[i];
    servos[i].write(pwmToAngle(pwm));
  }

  // --- Debug print ---
  static unsigned long lastPrint = 0;
  if(millis() - lastPrint > 100){
    lastPrint = millis();
    Serial.print("RX PWM: ");
    for(int i=0;i<CHANNELS;i++){
      Serial.print(pwmValues[i]);
      Serial.print(" ");
    }
    Serial.print(millis() - lastMsg > RC_TIMEOUT_MS ? "| FAILSAFE" : "| OK");
    Serial.println();
  }
}
