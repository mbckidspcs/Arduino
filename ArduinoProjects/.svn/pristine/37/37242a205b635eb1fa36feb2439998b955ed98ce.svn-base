#include <Servo.h>

Servo servo1, servo2, servo3, servo4, servo5, servo6;

void setup() {
  servo1.attach(2);
  servo2.attach(3);
  servo3.attach(4);
  servo4.attach(5);
  servo5.attach(6);
  servo6.attach(7);
}

void loop() {

  int speed = 85;
  // Rotate clockwise at half speed
  for (int i = 0; i < 5; i += 1) {
    servo1.write(speed);
    servo2.write(speed);
    servo3.write(speed);
    servo4.write(speed);
    servo5.write(speed);
    servo6.write(speed);
    delay(200);
  }

  // Stop
  servo1.write(90);
  servo2.write(90);
  servo3.write(90);
  servo4.write(90);
  servo5.write(90);
  servo6.write(90);
  delay(5000);

  
  speed = 96;
  // Rotate clockwise at half speed
  for (int i = 0; i < 5; i += 1) {
    servo1.write(speed);
    servo2.write(speed);
    servo3.write(speed);
    servo4.write(speed);
    servo5.write(speed);
    servo6.write(speed);
    delay(200);
  }

  // Stop
  servo1.write(90);
  servo2.write(90);
  servo3.write(90);
  servo4.write(90);
  servo5.write(90);
  servo6.write(90);
  delay(5000);


 
}
